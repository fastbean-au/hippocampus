{
	"name": "hippocampus-obsidian",
	"version": "0.1.1",
	"description": "Obsidian plugin bridging a vault to a Hippocampus memory service over its HTTP/JSON gateway.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test --import tsx test/*.test.ts"
	},
	"keywords": [
		"obsidian",
		"hippocampus",
		"memory"
	],
	"author": "fastbean-au",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.4.1",
		"builtin-modules": "^5.3.0",
		"esbuild": "^0.28.2",
		"obsidian": "^1.4.11",
		"tsx": "^4.7.0",
		"typescript": "^7.0.2"
	}
}
