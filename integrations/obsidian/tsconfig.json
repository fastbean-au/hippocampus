{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2018",
		"moduleResolution": "bundler",
		"allowJs": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"types": [
			"node"
		],
		"lib": [
			"DOM",
			"ES2018"
		]
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts"
	]
}
