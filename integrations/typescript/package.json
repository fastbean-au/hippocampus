{
  "name": "hippocampus-client",
  "version": "0.0.0-dev",
  "description": "The TypeScript client for Hippocampus, a memory service that forgets what stops mattering - generated from its contract, over gRPC or the JSON gateway.",
  "license": "MIT",
  "author": "fastbean-au",
  "keywords": [
    "hippocampus",
    "memory",
    "agent",
    "llm",
    "grpc",
    "connect"
  ],
  "homepage": "https://github.com/fastbean-au/hippocampus/blob/main/docs/typescript.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastbean-au/hippocampus.git",
    "directory": "integrations/typescript"
  },
  "bugs": "https://github.com/fastbean-au/hippocampus/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./grpc": {
      "types": "./dist/grpc.d.ts",
      "import": "./dist/grpc.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "buf generate",
    "build": "npm run generate && tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test build-test/test/*.test.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0"
  },
  "peerDependencies": {
    "@connectrpc/connect-node": "^2.3.0"
  },
  "peerDependenciesMeta": {
    "@connectrpc/connect-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@bufbuild/buf": false
  }
}
