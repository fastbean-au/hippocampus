# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
.DS_Store

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
coverage_detail.html

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/


demo/bin/
demo/data/

# The Bluesky demo's store. Other people's public posts, kept locally and never published; the
# demo script names the directory and the rm that removes it.
demo/data-bluesky/

# Soak run output (demo/soak.sh): one directory per run holding its generated config, the samples,
# the captured log and the report. A four-hour run's store lives under it too, so this is gigabytes.
# The report is the artefact worth keeping and it is meant to be copied into TODO.md, not committed
# here beside a database.
demo/soak-runs/

# Integration bridge build artifacts (`go build` in the module drops a binary named after the dir)
hippocampus-mcp
integrations/mcp/mcp
integrations/cli/cli
integrations/cli/hippo

TODO*.md
.claude/

# Python bytecode
__pycache__/
*.pyc

# SQLite sidecars beside the schema-upgrade fixtures. Opening a fixture directly (an operator's
# sqlite3, say) creates these; committing them would ship a fixture's uncheckpointed tail as a
# separate file, which the test — which copies only hippocampus.db — would never read.
db/testdata/schema/*/hippocampus.db-shm
db/testdata/schema/*/hippocampus.db-wal
