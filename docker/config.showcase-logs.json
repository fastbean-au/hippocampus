{
    "logging": {
        "level": "info",
        "json": true
    },
    "port": 50051,
    "gateway": {
        "port": 8080
    },
    "auth": {
        "method": "idp",
        "issuer": "http://localhost:8093/realms/hippocampus",
        "audience": "",
        "roleClaim": "realm_access.roles",
        "roleMapping": {},
        "jwksRefreshIntervalSeconds": 300,
        "readerRecallReinforces": false,
        "ui": {
            "issuer": "http://localhost:8093/realms/hippocampus",
            "clientId": "hippocampus-console",
            "scopes": "openid profile",
            "audience": ""
        }
    },
    "tls": {
        "enabled": false,
        "certFile": "",
        "keyFile": ""
    },
    "observability": {
        "tracing": {
            "enabled": true,
            "samplingRatio": 1.0
        },
        "metrics": {
            "enabled": true,
            "exportIntervalSeconds": 30
        },
        "otlp": {
            "endpoint": "otel-lgtm:4317",
            "insecure": true
        }
    },
    "storage": {
        "driver": "postgres",
        "directory": "",
        "postgres": {
            "dsn": "postgres://hippocampus:hippocampus@postgres:5432/hippocampus?sslmode=disable"
        }
    },
    "opensearch": {
        "enabled": true,
        "addresses": [
            "http://opensearch:9200"
        ],
        "username": "",
        "password": "",
        "index": "hippocampus-memories",
        "queueSize": 4096,
        "reconcileIntervalSeconds": 600,
        "reconcileBatchSize": 500
    },
    "memory": {
        "limit": {
            "sizeBytes": 1048576
        },
        "minimumSignificance": 0
    },
    "event": {
        "minimumSignificance": 0
    },
    "sleep": {
        "periodSeconds": 120
    },
    "consolidation": {
        "defaultEventSignificanceValue": 0,
        "defaultEventSignificancePercentile": 25,
        "minimumAgeInDays": 0,
        "minimumRetentionInDays": 0,
        "aggressiveness": 1.0,
        "deletionThreshold": 5,
        "method": 1,
        "unitsOfAgeInDays": 0.002,
        "relationshipSignificanceWeight": 1.0,
        "recallSignificanceWeight": 1.0,
        "capacityMemories": 50000,
        "capacityPressureExponent": 4.0,
        "capacityBytes": 200000000,
        "capacityBytesFloor": 180000000,
        "walTriggerBytes": 0,
        "summarisationMinMemories": 0,
        "summarisationMinAgeInDays": 0,
        "summarisationMaxCandidates": 0
    }
}
