# Caddy reverse proxy for the "logs" showcase stack. Same shape as Caddyfile.book (automatic HTTPS,
# hostname routing, the network-alias split-issuer fix) for the logs domain, so the two stacks run
# side by side on one host. See Caddyfile.book for the design notes and docs/showcase.md for local
# eval.
{
	email {$ACME_EMAIL:admin@example.com}
}

{$LOGS_DOMAIN:logs.hippocampus.example} {
	reverse_proxy hippocampus:8080
}

auth.{$LOGS_DOMAIN:logs.hippocampus.example} {
	reverse_proxy keycloak:8080
}

grafana.{$LOGS_DOMAIN:logs.hippocampus.example} {
	reverse_proxy otel-lgtm:3000
}
