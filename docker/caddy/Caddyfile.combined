# Caddy reverse proxy for the COMBINED showcase (both examples, one domain, one host). A single Caddy
# owns :80/:443 and routes four subdomains of one parent domain to the two consoles, the shared
# Keycloak, and the shared Grafana. See Caddyfile.book for the split-issuer rationale; the difference
# here is that ONE Caddy fronts BOTH stacks (two Caddys cannot share the host ports), and auth./
# grafana. are shared rather than per-stack.
#
# Everything derives from one variable, BASE_DOMAIN (default hippocampus.example). Requires public
# DNS for book.${BASE_DOMAIN}, logs.${BASE_DOMAIN}, auth.${BASE_DOMAIN}, grafana.${BASE_DOMAIN} (or a
# *.${BASE_DOMAIN} wildcard) pointing at the host, with 80/443 reachable for the ACME challenge. NB do
# NOT use a *.localhost name here: libc/Go resolve the .localhost TLD to loopback (RFC 6761) and
# bypass the compose DNS alias, which would break the split-issuer fix.
{
	email {$ACME_EMAIL:admin@example.com}
}

book.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy hippocampus-book:8080
}

logs.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy hippocampus-logs:8080
}

auth.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy keycloak:8080
}

grafana.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy otel-lgtm:3000
}
